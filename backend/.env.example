# ════════════════════════════════════════════════════════════════
# 复制为 .env 并按需填写；未填则走 mock（无密钥也能跑通整条流水线）。
#
# 出图 Provider 推荐：volc（火山方舟 / 即梦 Seedream）
#   - 免费额度 5000 tokens，无门槛、无水印，个人验证几乎零成本。
#   - Key 获取：https://console.volcengine.com/ark → 左侧「API Key 管理」创建。
#   - 开通模型：方舟控制台「开通管理」开通 doubao-seedream / seedance 系列，
#     并按量付费需账户预存 200 元（可消费，非押金）。
# 备选：kling（可灵）
#   - 质感好但按秒计费（≈0.6 元/秒），资源包起价 2500 元，适合高质感混用。
#   - Key 获取：https://klingai.com/cn/dev → 右上角「API 密钥」。
# 即梦(jimeng) 开发者能力已并入火山方舟，填 jimeng key 会与 volc 复用同一后端。
# ════════════════════════════════════════════════════════════════

APP_NAME=TextToVideo Agent
ENV=local

# 存储（本地开发用相对路径；Docker 内由 compose 覆盖）
DATABASE_URL=sqlite:///./text_video.db
MEDIA_ROOT=./media

# 异步任务（本地无 Redis 时设 false，走 BackgroundTasks）
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false

# 出图 provider: mock | jimeng | kling | volc
DEFAULT_PROVIDER=mock
# 视频生成（do_i2v=True 时启用）：provider 自带 I2V，无需额外配置
DO_I2V=false

# 即梦 / 火山 Seedance（推荐 volc）
JIMENG_API_KEY=
JIMENG_BASE_URL=https://api.jimeng.jianying.com
# 可灵
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com
# 火山方舟（Seedance-mini 免费额度，个人首选）
VOLC_API_KEY=
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 配音: edge | silent   （edge=微软免费在线TTS，联网即用；silent=静音兜底）
DEFAULT_TTS=edge

# LLM 分镜: mock | openai | deepseek
# 想要真实自动分镜：填 deepseek（兼容 OpenAI 协议）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

ASPECT_RATIO=16:9
DEFAULT_RESOLUTION=1920x1080
